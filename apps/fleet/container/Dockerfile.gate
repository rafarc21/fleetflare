# apps/fleet/container/Dockerfile.gate — GateRunnerDO's image (#715 Phase 1).
# Runs fleetflare's real lanes (#1011): node for vitest (`#!/usr/bin/env node`),
# tmux and /usr/local/bin/chromium for the bun-test lane (same toolset as
# scripts/localci/Dockerfile). #1037: python3 + procps (bringup gates run
# python3; the lane's tests pgrep/ps), a C linker for crates, and a pinned
# Rust 1.96 toolchain for the gate's Rust-workspace lane.
# Plain bun base, same shape Dockerfile.deploy already uses, and the same
# reproducible-build rules its header states (scripts/image-repro-check.sh):
#   - SOURCE_DATE_EPOCH fixes the image's created/history times; bump never.
#   - base image pinned by digest; apt from the dated APT_SNAPSHOT; every
#     download pinned by version (and checksum where it is a file).
#   - every RUN that installs or downloads is wrapped in repro-seal begin/end.
# IMAGE CHANGE: ships only at an operator-approved image window.
ARG SOURCE_DATE_EPOCH=1790640000

FROM oven/bun:1.3-debian@sha256:9dba1a1b43ce28c9d7931bfc4eb00feb63b0114720a0277a8f939ae4dfc9db6f AS src
ARG SOURCE_DATE_EPOCH
COPY repro-seal.sh gate-server.ts gate-merge-tree.ts /src/
RUN mkdir -p /src/base/etc /src/base/usr/local/bin /src/base/workspace /src/app/app \
    && printf '127.0.0.1\tlocalhost\n::1\tlocalhost ip6-localhost ip6-loopback\n' > /src/base/etc/hosts \
    && mv /src/repro-seal.sh /src/base/usr/local/bin/repro-seal \
    && mv /src/gate-server.ts /src/gate-merge-tree.ts /src/app/app/ \
    && chmod -R u=rwX,go=rX /src && chmod 0755 /src/base/usr/local/bin/repro-seal \
    && find /src -exec touch -h -d "@$SOURCE_DATE_EPOCH" {} +

FROM oven/bun:1.3-debian@sha256:9dba1a1b43ce28c9d7931bfc4eb00feb63b0114720a0277a8f939ae4dfc9db6f
ARG SOURCE_DATE_EPOCH
ARG APT_SNAPSHOT=20260929T000000Z
COPY --from=src /src/base/ /

# git: anonymous clone and merge-tree. tmux: the bun-test lane's wake-cmd
# drives a real tmux server. xz-utils: unpacks the node tarball below.
# python3 + procps: bringup gates run python3, tests pgrep/ps (#1037, 94
# bun-lane failures without them). zstd: pack/unpack test fixtures.
# gcc g++ make libc6-dev binutils jq: the C toolchain a Rust workspace's
# linker needs, plus jq for gate-server's JSON plumbing.
RUN --mount=type=tmpfs,target=/tmp repro-seal begin \
    && apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl xz-utils tmux \
      python3 procps zstd gcc g++ make libc6-dev jq binutils \
    && repro-seal end

# Node 22.23.3 (LTS): checksum-verified before it is unpacked (never a curl | sh).
RUN --mount=type=tmpfs,target=/tmp repro-seal begin \
    && curl -fsSL -o /tmp/node-v22.23.3-linux-x64.tar.xz https://nodejs.org/dist/v22.23.3/node-v22.23.3-linux-x64.tar.xz \
    && echo "df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de  /tmp/node-v22.23.3-linux-x64.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/node-v22.23.3-linux-x64.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
    && node --version \
    && repro-seal end

# Rust 1.96.0, pinned by rustup 1.28.2 (sha256-verified, never curl | sh):
# minimal profile, rustfmt + clippy + llvm-tools, and the wasm target a
# Cloudflare-worker workspace needs. #1037.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN --mount=type=tmpfs,target=/tmp repro-seal begin \
    && curl -fsSL -o /tmp/rustup-init https://static.rust-lang.org/rustup/archive/1.28.2/x86_64-unknown-linux-gnu/rustup-init \
    && echo "20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain 1.96.0 -c rustfmt,clippy,llvm-tools-preview -t wasm32-unknown-unknown \
    && rustc --version && cargo --version && python3 --version && pgrep --version \
    && rm -rf /tmp/rustup-init /usr/local/rustup/downloads \
    && repro-seal end

# Chromium: the same pinned Playwright build scripts/localci/Dockerfile uses,
# symlinked to the exact path the ego-browser shim launches. --with-deps
# apt-installs the libs that build needs.
RUN --mount=type=tmpfs,target=/tmp repro-seal begin \
    && mkdir -p /opt/pw && cd /opt/pw \
    && bun x playwright@1.63.0 install chromium --with-deps \
    && ln -sf /root/.cache/ms-playwright/chromium-*/chrome-linux64/chrome /usr/local/bin/chromium \
    && /usr/local/bin/chromium --version \
    && tmux -V \
    && rm -rf /var/lib/apt/lists/* \
    && repro-seal end

COPY --from=src /src/app/ /
ENV PORT=8080
EXPOSE 8080
CMD ["bun", "run", "/app/gate-server.ts"]
