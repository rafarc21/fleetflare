# apps/fleet/container/Dockerfile.gate-desktop — GateRunnerDO's "desktop" image (#1066).
# For a repo whose gate block names "image": "desktop": Rust cross-check to Windows
# (cargo-xwin + a baked Windows SDK/CRT) and pwsh + Pester, on the bun base alone (no
# node, tmux or chromium: no desktop leg runs them). Same reproducible-build rules as Dockerfile.gate;
# scripts/image-repro-check.sh gate-desktop proves them.
# LICENCE: the baked Windows SDK/CRT stays in the operator's PRIVATE registry only.
# Never push this image to a public registry.
# IMAGE CHANGE: ships only at an operator-approved image window.
ARG SOURCE_DATE_EPOCH=1790640000

FROM oven/bun:1.3-debian@sha256:9dba1a1b43ce28c9d7931bfc4eb00feb63b0114720a0277a8f939ae4dfc9db6f AS src
ARG SOURCE_DATE_EPOCH
COPY repro-seal.sh gate-server.ts gate-merge-tree.ts /src/
RUN mkdir -p /src/base/etc /src/base/usr/local/bin /src/base/workspace /src/app/app \
    && printf '127.0.0.1\tlocalhost\n::1\tlocalhost ip6-localhost ip6-loopback\n' > /src/base/etc/hosts \
    && mv /src/repro-seal.sh /src/base/usr/local/bin/repro-seal \
    && mv /src/gate-server.ts /src/gate-merge-tree.ts /src/app/app/ \
    && chmod -R u=rwX,go=rX /src && chmod 0755 /src/base/usr/local/bin/repro-seal \
    && find /src -exec touch -h -d "@$SOURCE_DATE_EPOCH" {} +

FROM oven/bun:1.3-debian@sha256:9dba1a1b43ce28c9d7931bfc4eb00feb63b0114720a0277a8f939ae4dfc9db6f
ARG SOURCE_DATE_EPOCH
ARG APT_SNAPSHOT=20260929T000000Z
COPY --from=src /src/base/ /

# git: gate-server clone + merge-tree. gcc libc6-dev: host linker, aws-lc C build.
# clang lld llvm: clang-cl, lld-link, llvm-lib for cargo-xwin. libicu76: pwsh aborts
# without ICU. unzip: the Pester nupkg.
RUN --mount=type=tmpfs,target=/tmp repro-seal begin \
    && apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl unzip gcc libc6-dev clang lld llvm libicu76 \
    && repro-seal end

# Tauri Linux system deps (#1274): the desktop leg's `cargo test` on a Tauri
# crate needs webkit2gtk-4.1, gtk3, libsoup3 and the bindgen/cc toolchain
# (libclang-dev, cmake, ninja-build). Lives on THIS image, not the default gate
# image: the +1.1 GB must not land on every repo's legs. The package list is the
# operator-measured one that ran the peer repo's scripts/cargo-test-gate.sh to
# 282 passed / 0 failed (10-23). This base (oven/bun:1.3-debian) is trixie,
# whose webkit2gtk is still 4.1.
RUN --mount=type=tmpfs,target=/tmp repro-seal begin \
    && apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config libssl-dev \
      libwebkit2gtk-4.1-dev libgtk-3-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
      libayatana-appindicator3-dev librsvg2-dev libxdo-dev libasound2-dev \
      libclang-dev cmake ninja-build \
    && repro-seal end

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    XWIN_CACHE_DIR=/opt/xwin \
    XWIN_ARCH=x86_64

# Rust 1.99.1 + x86_64-pc-windows-msvc std, rustup-init sha256-verified. Minimal profile:
# no rustfmt/clippy, no leg runs them.
RUN --mount=type=tmpfs,target=/tmp repro-seal begin \
    && curl -fsSL -o /tmp/rustup-init https://static.rust-lang.org/rustup/archive/1.28.2/x86_64-unknown-linux-gnu/rustup-init \
    && echo "20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain 1.99.1 -t x86_64-pc-windows-msvc \
    && curl -fsSL -o /tmp/channel-rust-1.99.1.toml https://static.rust-lang.org/dist/channel-rust-1.99.1.toml \
    && echo "fb152be80975c194aa5fc684b2aec3a6e14e2b855efe2faa4e5f8ae6e590f463  /tmp/channel-rust-1.99.1.toml" | sha256sum -c - \
    && cp /tmp/channel-rust-1.99.1.toml /usr/local/rustup/toolchains/1.99.1-x86_64-unknown-linux-gnu/lib/rustlib/multirust-channel-manifest.toml \
    && rustc --version && cargo --version \
    && rm -rf /usr/local/rustup/downloads \
    && repro-seal end

# cargo-xwin 0.23.1: the tarball holds one file, the cargo-xwin binary.
RUN --mount=type=tmpfs,target=/tmp repro-seal begin \
    && curl -fsSL -o /tmp/cargo-xwin.tar.gz https://github.com/rust-cross/cargo-xwin/releases/download/v0.23.1/cargo-xwin-v0.23.1.x86_64-unknown-linux-musl.tar.gz \
    && echo "c492c6dfb7e5ac0eee586b796e0fc950ba13077e7f0bbb046f445d71790d5360  /tmp/cargo-xwin.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/cargo-xwin.tar.gz -C /usr/local/cargo/bin --no-same-owner cargo-xwin \
    && cargo xwin --version \
    && repro-seal end

# MSVC CRT + Windows SDK, baked: a per-leg download took 12m53s. Own layer (largest blob;
# a failed push retries it alone). DONE lists files in HashSet order (random per run):
# sorted, or every cold build gets a new digest.
RUN --mount=type=tmpfs,target=/tmp repro-seal begin \
    && for t in 1 2 3; do rm -rf /opt/xwin/xwin && XWIN_SDK_VERSION=10.0.26100 XWIN_CRT_VERSION=14.44.17.14 cargo xwin cache xwin && break; [ "$t" -lt 3 ] || exit 1; done \
    && { head -n1 /opt/xwin/xwin/DONE; tail -n +2 /opt/xwin/xwin/DONE | LC_ALL=C sort; } > /tmp/DONE \
    && cp /tmp/DONE /opt/xwin/xwin/DONE \
    && repro-seal end

# pwsh 7.6.7 + Pester 6.2.0 (AllUsers module path: the leg's /tmp/pwsh copy finds it).
RUN --mount=type=tmpfs,target=/tmp repro-seal begin \
    && curl -fsSL -o /tmp/powershell-7.6.7-linux-x64.tar.gz https://github.com/PowerShell/PowerShell/releases/download/v7.6.7/powershell-7.6.7-linux-x64.tar.gz \
    && echo "6896f9e3a6b0a354bf470835a96da76d2f801cd50dcf047ad7c4563bf93bf431  /tmp/powershell-7.6.7-linux-x64.tar.gz" | sha256sum -c - \
    && mkdir -p /opt/pwsh && tar -xzf /tmp/powershell-7.6.7-linux-x64.tar.gz -C /opt/pwsh --no-same-owner \
    && chmod 0755 /opt/pwsh/pwsh && ln -s /opt/pwsh/pwsh /usr/local/bin/pwsh \
    && curl -fsSL -o /tmp/pester.6.2.0.nupkg https://cdn.powershellgallery.com/packages/pester.6.2.0.nupkg \
    && echo "e6ac7418d4f12500269aaca58ae56cf1caafbbf1afa2cec334e289d1cf50a239  /tmp/pester.6.2.0.nupkg" | sha256sum -c - \
    && M=/usr/local/share/powershell/Modules/Pester/6.2.0 && mkdir -p "$M" \
    && unzip -q /tmp/pester.6.2.0.nupkg -d "$M" \
    && rm -rf "$M/_rels" "$M/package" "$M/[Content_Types].xml" "$M/Pester.nuspec" \
    && pwsh -NoProfile -NonInteractive -Command 'Import-Module Pester -RequiredVersion 6.2.0' \
    && rm -rf /root/.cache/powershell /root/.local/share/powershell \
    && repro-seal end

COPY --from=src /src/app/ /
ENV PORT=8080
EXPOSE 8080
CMD ["bun", "run", "/app/gate-server.ts"]
