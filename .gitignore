.DS_Store
*.log
.wrangler/
.superpowers/
apps/fleet/.mcp.json

# Real, account-specific Cloudflare Worker config (App id, installation ids,
# D1/R2 ids, real repo/org names, workers.dev host). Issue #329 critical fix
# round: this no longer lives here at all, tracked or not — it lives in the
# private rafarc21/fleetflare-ops repo, at fleet/wrangler.jsonc, checked out
# on the operator's own deploy machine. This entry stays, harmlessly, in case
# a legacy copy is still sitting on someone's disk at this exact path.
apps/fleet/wrangler.jsonc

# Generated by scripts/deploy.sh: a same-directory copy of the operator's real
# config (see FLEET_CONFIG/FLEET_OPS_DIR in that script) so wrangler resolves
# `main` and each container's Dockerfile path relative to apps/fleet/,
# regardless of where the source ops-repo checkout lives on disk. Never
# tracked, never hand-edited.
apps/fleet/wrangler.local.jsonc

# Local wrangler-dev secret overrides (dotenv-parsed; see
# apps/fleet/.dev.vars.example for the expected shape). Also written/removed
# automatically by test-integration/harness.ts for e2e runs.
apps/fleet/.dev.vars
.context/
.fleet/done.json
.fleet/done/*.json
